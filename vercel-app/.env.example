# ---- Copy to Vercel → Project → Settings → Environment Variables ----

# Upstash Redis (Storage → Create Database, or upstash.com). Use the REST URL + token.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Session signing key — generate a long random string, e.g.  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Meesho SMTP relay (transactional email for OTP)
SMTP_HOST=smtp.meesho.internal
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=VALMO Portal <no-reply@meesho.com>
